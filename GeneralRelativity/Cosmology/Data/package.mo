within GeneralRelativity.Cosmology;
package Data "Measured and reference cosmological data"
  annotation(Documentation(info="<html>
<p>The Planck 2018 temperature power spectrum (<a href=\"modelica://GeneralRelativity.Cosmology.Data.planck2018TT\">planck2018TT</a>)
and Planck's best-fit Lambda-CDM spectrum (<a href=\"modelica://GeneralRelativity.Cosmology.Data.planck2018BestFit\">planck2018BestFit</a>),
as plain arrays.</p>
</html>"));
end Data;
